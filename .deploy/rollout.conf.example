# Load balancer settings for rollout.sh. Copy to rollout.conf beside it; rollout.conf is not in this
# repository.
#
# Only what this host has to decide is listed. Everything rollout.sh already defaults to sensibly is
# left out, so this file cannot go stale.

# HAProxy runtime socket. It ships as srw------- root:haproxy, so either run the rollout as root, or
# set `mode 660` on the stats socket line in haproxy.cfg and put the operator in the haproxy group.
# Only the load balancer side needs privilege; the servers need none.
HAPROXY_SOCKET=/run/haproxy/haproxy.sock

# SSH user on every API server. It is the service user: it owns the binary directory and restarts its
# own user unit, so no sudo is involved. Leave empty to let ~/.ssh/config decide.
SSH_USER=unipept

# Where a failed rollout writes to. Left empty, nobody is emailed and the failure is only in the
# terminal and the journal. The same address HAProxy's own email-alert uses is the obvious choice.
NOTIFY_TO=unipept@ugent.be

# Uncomment to depart from the defaults.
#NOTIFY_SMTP=127.0.0.1:25
#LOCK_FILE=/tmp/unipept-rollout.lock
#DRAIN_TIMEOUT=240
#HEALTH_TIMEOUT=60
# Only for a server whose deploy.sh is too old to report a READY_TIMEOUT of its own. Each server
# names its deadline in its environment file, where the index it reads is also described.
#READY_TIMEOUT=900
#REMOTE_DEPLOY=/opt/unipept-api/lib/deploy.sh
