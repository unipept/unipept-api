# Applies the netfilter rule that lets port 80 reach the API, at every boot.
#
# A system unit, because only root can change netfilter. It is the one part of running this service
# that a deploy never touches: the rules follow PORT in the environment file, so they change when a
# person changes that, not when a release is installed.

[Unit]
Description=Send port 80 to the Unipept API
Documentation=https://github.com/unipept/unipept-api/wiki/Deploying-the-Unipept-API
# Before anything can be routed, and before the API is worth reaching.
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
# The rules outlive the process that set them, so systemd should report the unit as active rather
# than as finished-and-gone.
RemainAfterExit=yes
ExecStart=/opt/unipept-api/lib/unipept-api-ports.sh

[Install]
WantedBy=multi-user.target
