# Per-host configuration, installed at /opt/unipept-api/etc/unipept-api.env.
# Values below are examples. The real file is not in this repository.

# Index data directory. Change this when switching to a new index. Not under /home: the unit sets
# ProtectHome=yes.
INDEX_LOCATION=/mnt/ssd/uniprot-2025-04/suffix-array

# OpenSearch address. Each server runs its own, on localhost.
DATABASE_ADDRESS=http://localhost:9200

# The port the service listens on. Above 1024, because a systemd user unit cannot hold
# CAP_NET_BIND_SERVICE and so cannot bind 80 itself.
#
# HAProxy still connects on 80: unipept-api-ports.service redirects what arrives on 80 to this port.
# The two numbers are meant to differ — this one is what the process binds, 80 is what the network
# uses. Change this and the redirect has to change with it, which install.sh does.
PORT=8080

# Which release build this host takes: mmap (everything mapped), preloaded (everything resident)
# or hybrid (only the suffix array mapped). The storage backend is compiled in, so this is a
# property of the host.
VARIANT=mmap

# Log filter. Left unset on purpose: the binary carries this same default, and a copy here would
# be the one that goes stale. Set it only to depart from that default.
#RUST_LOG=

# Raise well above the core count when the index is not fully resident, where a faulting thread
# otherwise idles a core. It costs about 10% when the index is resident.
#RAYON_NUM_THREADS=
