# Per-host configuration, installed at /etc/unipept-api/unipept-api.env.
# Values below are examples. The real file is not in this repository.

# Index data directory. Change this when switching to a new index.
INDEX_LOCATION=/mnt/ssd/uniprot-2025-04/suffix-array

# OpenSearch address.
DATABASE_ADDRESS=http://localhost:9200

# Port the API listens on.
PORT=80

# Which release build this host takes: mmap (everything mapped), preloaded (everything
# resident) or hybrid (only the suffix array mapped). The storage backend is compiled in, so
# this is a property of the host.
VARIANT=mmap

# Log filter. Remove the line to use the built-in default.
RUST_LOG=warn,unipept_api=info,datastore=info,index=info,tower_http=info,axum::rejection=trace

# Raise well above the core count when the index is not fully resident, where a faulting
# thread otherwise idles a core. It costs about 10% when the index is resident.
#RAYON_NUM_THREADS=
